# Copiar a .env y ajustar. Nunca commitear .env.

# --- Base de datos ---
POSTGRES_USER=unsa
POSTGRES_PASSWORD=unsa_dev_password
POSTGRES_DB=unsa_audit
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://unsa:unsa_dev_password@localhost:5433/unsa_audit

# --- Seguridad ---
# Email que recibe el rol superadmin al registrarse/seed
SUPERADMIN_EMAIL=superadmin@unsa-poc.example
# Password inicial de la cuenta superadmin; la crea el seed (uv run python -m unsa_audit.seed)
SUPERADMIN_PASSWORD=change-me-superadmin-dev
JWT_SECRET=change-me-in-dev-use-a-long-random-string
JWT_EXPIRE_MINUTES=120

# --- IA (agy / Antigravity CLI, sin API key) ---
AGY_COMMAND=agy
AGY_ARGS=--output-format json --mode plan --sandbox --effort low
AGY_TIMEOUT_SECONDS=120

# --- Frontend (solo servidor SvelteKit; opcional, default http://localhost:8000) ---
API_URL=http://localhost:8000
